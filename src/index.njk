---
docTitle: "Sock Guide — Best Socks by Job, Sport & Weather"
layout: layouts/base.njk
title: Best Socks by Use — Work, Running, Heated & More
description: "Sock Guide helps you choose the right socks for the job: best work socks, socks for work boots, alpaca socks, heated socks for hunting and tennis socks — plus buying guides on summer socks, cotton vs merino wool, sock heights, choosing the right socks and sweaty feet."
isHome: true
---
{# Featured guide: Best Work Socks (artifact hero copy/image) #}
<section class="hero" aria-label="Featured guide">
{% for p in collections.posts %}{% if p.fileSlug == "best-work-socks" %}
{% set a = artifact.posts[p.fileSlug] %}
  <a class="hero-link" href="{{ '/posts/best-work-socks/' | url }}">
  <figure><img src="{{ ('/' ~ (a.image or ('img/' ~ p.data.image))) | url }}" alt="{{ a.imageAlt or p.data.imageAlt }}"></figure>
  <div>
    <p class="kicker">{{ artifact.heroKicker }}</p>
    <h1>{{ a.heroTitle or p.data.title }}</h1>
    <p class="excerpt">{{ a.heroExcerpt or p.data.description }}</p>
  </div>
  </a>
{% endif %}{% endfor %}
</section>

{# AdSense slot (leaderboard, after hero). Empty and hidden until a real publisher ID is added; no ad script loads. #}
<div class="ad-slot" data-ad-slot="leaderboard" hidden aria-hidden="true"></div>

{# Row of 3 cards, in artifact order: Work Boots, Alpaca, Heated #}
<section class="feat-row" aria-label="Featured guides">
{% for slug in ["best-socks-for-work-boots", "best-alpaca-socks", "best-heated-socks-for-hunting"] %}
{% for p in collections.posts %}{% if p.fileSlug == slug %}
{% set a = artifact.posts[p.fileSlug] %}
  <a class="feat-card" href="{{ p.url }}"{% if a.dataSearch %} data-search="{{ a.dataSearch }}"{% endif %}>
    <div class="ph"><img src="{{ ('/' ~ (a.image or ('img/' ~ p.data.image))) | url }}" alt="{{ a.imageAlt or p.data.imageAlt }}"></div>
    <div class="label-box">
      <p class="kicker">{{ a.label or p.data.category }}</p>
      <h3>{{ a.cardTitle or p.data.title }}</h3>
    </div>
  </a>
{% endif %}{% endfor %}
{% endfor %}
</section>

{# Latest posts + sidebar #}
<section class="latest" aria-labelledby="latest">
  <div>
    <div class="section-head" id="latest"><h2>LATEST POSTS</h2></div>
    <div class="post-list" id="postList">
  {% for p in collections.latestPosts %}
{% set a = artifact.posts[p.fileSlug] %}
      <a class="post-item{% if loop.index > 3 %} extra{% endif %}" href="{{ p.url }}"{% if a.dataSearch %} data-search="{{ a.dataSearch }}"{% endif %}>
        <img src="{{ ('/' ~ (a.image or ('img/' ~ p.data.image))) | url }}" alt="{{ a.imageAlt or p.data.imageAlt }}">
        <div>
          <p class="kicker">{{ a.label or p.data.category }}</p>
          <h3>{{ a.cardTitle or p.data.title }}</h3>
          <p>{{ a.excerpt or p.data.description }}</p>
        </div>
      </a>
  {% endfor %}
      <p class="no-results" id="noResults">No guides match that search yet. Try “work”, “summer”, “merino”, “heated” or “tennis”.</p>
    </div>
    <div class="load-more-wrap"><button class="btn-load" id="loadMoreBtn" type="button">LOAD MORE</button></div>
  </div>
  <aside>
    <div class="side-box">
      <h3>Welcome to Sock Guide</h3>
      <p>Sock Guide collects plain, practical guides to choosing the right socks for work, sport and cold weather.</p>
    </div>
    {# AdSense slot (sidebar). Empty and hidden until a real publisher ID is added; no ad script loads. #}
    <div class="ad-slot" data-ad-slot="sidebar" hidden aria-hidden="true"></div>
    <div class="side-box">
      <h3>Subscribe to Newsletter</h3>
      <form class="news-form" data-newsletter>
        <input type="email" id="newsletter-email-sidebar" name="email" placeholder="Your email address" required aria-label="Email address">
        <button class="btn-black" type="submit">Subscribe</button>
      </form>
      <p class="news-done" role="status">Your email app is opening — send the message there to finish subscribing.</p>
    </div>
  </aside>
</section>

<script>
(function () {
  var btn = document.getElementById('loadMoreBtn');
  var list = document.querySelector('.post-list');
  if (!btn || !list) return;
  btn.addEventListener('click', function () {
    list.classList.add('show-all');
    btn.style.display = 'none';
  });
  if (!document.querySelector('.post-item.extra')) btn.style.display = 'none';
})();
</script>
