---
layout: layouts/base.njk
title: Search
description: "Search every Sock Guide article — socks by job, sport, weather and material."
permalink: /search/
---
<article>
<header class="article-head">
  <p class="crumb"><a href="{{ '/' | url }}">Home</a> › Search</p>
  <h1>Search</h1>
</header>
<div class="search-page">
  <form id="searchPageForm" role="search">
    <input type="search" id="searchPageInput" placeholder="Search guides — try “work boots”, “alpaca”, “tennis”…" aria-label="Search guides">
    <button class="btn-black" type="submit">Search</button>
  </form>
  <p class="search-meta" id="searchMeta" role="status">Search every guide on the site.</p>
  <div class="search-chips" id="searchChips">
    <button type="button" data-q="work boots">Work boots</button>
    <button type="button" data-q="merino">Merino</button>
    <button type="button" data-q="running">Running</button>
    <button type="button" data-q="sweaty feet">Sweaty feet</button>
    <button type="button" data-q="heated">Heated</button>
  </div>
  <div class="post-list" id="searchResults" data-index-url="{{ '/search.json' | url }}" data-img-base="{{ '/img/' | url }}"></div>
  <p class="no-results" id="searchNoResults">No guides match that search yet. Try “work”, “summer”, “merino”, “heated” or “tennis”.</p>
</div>
</article>
<script>
(function () {
  var input = document.getElementById('searchPageInput');
  var form = document.getElementById('searchPageForm');
  var meta = document.getElementById('searchMeta');
  var chips = document.getElementById('searchChips');
  var results = document.getElementById('searchResults');
  var noResults = document.getElementById('searchNoResults');
  var indexUrl = results.getAttribute('data-index-url');
  var imgBase = results.getAttribute('data-img-base');
  var index = null;

  function esc(s) {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
  function haystack(item) {
    return (item.title + ' ' + item.category + ' ' + item.excerpt + ' ' + item.keywords).toLowerCase();
  }
  function run(q) {
    var raw = q.trim();
    var words = raw.toLowerCase().split(/\s+/).filter(Boolean);
    if (!words.length) {
      results.innerHTML = '';
      meta.textContent = index ? 'Search all ' + index.length + ' guides.' : 'Search every guide on the site.';
      noResults.classList.remove('show');
      chips.style.display = '';
      return;
    }
    chips.style.display = 'none';
    var scored = [];
    index.forEach(function (item, i) {
      var hay = haystack(item);
      if (!words.every(function (w) { return hay.indexOf(w) !== -1; })) return;
      var score = 0;
      var titleHay = item.title.toLowerCase();
      var keyHay = item.keywords.toLowerCase();
      if (words.every(function (w) { return titleHay.indexOf(w) !== -1; })) score = 2;
      else if (words.every(function (w) { return keyHay.indexOf(w) !== -1; })) score = 1;
      scored.push({ item: item, score: score, order: i });
    });
    scored.sort(function (a, b) { return b.score - a.score || a.order - b.order; });
    if (!scored.length) {
      results.innerHTML = '';
      meta.textContent = 'No guides match \u201c' + raw + '\u201d yet.';
      noResults.classList.add('show');
      return;
    }
    noResults.classList.remove('show');
    meta.textContent = scored.length === 1
      ? '1 guide matches \u201c' + raw + '\u201d.'
      : scored.length + ' guides match \u201c' + raw + '\u201d.';
    results.innerHTML = scored.map(function (s) {
      var it = s.item;
      return '<a class="post-item" href="' + esc(it.url) + '" data-search="' + esc(it.keywords) + '">' +
        '<picture><source type="image/webp" srcset="' + imgBase + it.img + '-400w.webp">' +
        '<img src="' + imgBase + it.img + '-400w.jpeg" alt="' + esc(it.alt) + '" loading="lazy" decoding="async" width="' + it.w + '" height="' + it.h + '"></picture>' +
        '<div><p class="kicker">' + esc(it.category) + '</p><h3>' + esc(it.title) + '</h3><p>' + esc(it.excerpt) + '</p></div></a>';
    }).join('');
  }
  function setQueryInUrl(q) {
    var url = new URL(window.location.href);
    if (q.trim()) url.searchParams.set('q', q.trim());
    else url.searchParams.delete('q');
    window.history.replaceState(null, '', url);
  }
  fetch(indexUrl).then(function (r) { return r.json(); }).then(function (data) {
    index = data;
    var q = new URLSearchParams(window.location.search).get('q') || '';
    if (q) { input.value = q; run(q); }
    else { meta.textContent = 'Search all ' + index.length + ' guides.'; }
  }).catch(function () {
    meta.textContent = 'Search is unavailable right now — please try again later.';
  });
  input.addEventListener('input', function () {
    setQueryInUrl(input.value);
    if (index) run(input.value);
  });
  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (index) run(input.value);
  });
  chips.addEventListener('click', function (e) {
    var b = e.target.closest('button');
    if (!b) return;
    input.value = b.getAttribute('data-q');
    input.focus();
    setQueryInUrl(input.value);
    if (index) run(input.value);
  });
})();
</script>
