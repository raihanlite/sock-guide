---
layout: layouts/base.njk
---
{% set a = artifact.posts[page.fileSlug] %}
<div class="article-head">
  <p class="crumb">{{ a.label or category }}</p>
  <h1>{{ title }}</h1>
  <p class="pub-date">{{ date | displayDate(page.fileSlug) }}</p>
</div>
{% if image %}<figure class="article-hero"><img src="{{ ('/img/' ~ image) | url }}" alt="{{ imageAlt }}">{% if imageCredit %}<figcaption>Photo: {{ imageCredit }}</figcaption>{% endif %}</figure>{% endif %}
{# AdSense slot (in-article). Empty and hidden until a real publisher ID is added; no ad script loads. #}
<div class="ad-slot" data-ad-slot="in-article" hidden aria-hidden="true"></div>
<div class="prose">
{{ content | safe }}
</div>
