---
layout: layouts/base.njk
---
<article class="post">
<header class="post-head">
{% set a = artifact.posts[page.fileSlug] %}
<p class="eyebrow">{{ a.label or category }}</p>
<h1>{{ title }}</h1>
<p class="meta">Published {{ date | displayDate(page.fileSlug) }} · {{ a.label or category }}</p>
</header>
{% if image %}<figure class="hero-img"><img src="{{ ('/img/' ~ image) | url }}" alt="{{ imageAlt }}">{% if imageCredit %}<figcaption>Photo: {{ imageCredit }}</figcaption>{% endif %}</figure>{% endif %}
{# AdSense slot (in-article). Empty and hidden until a real publisher ID is added; no ad script loads. #}
<div class="ad-slot" data-ad-slot="in-article" hidden aria-hidden="true"></div>
<div class="post-body">
{{ content | safe }}
</div>
</article>
