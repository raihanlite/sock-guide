<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% set ogTitle = docTitle or (title ~ " | " ~ site.title) %}
{% set ogDesc = site.ogDescription if isHome else (description or site.description) %}
{% set ogUrl = "https://raihanlite.github.io" ~ (page.url | url) %}
{% set heroFile = (image | replace("artifact/", "")) if image else "img-05.jpg" %}
{% set heroSize = ogImages[heroFile] %}
<title>{{ ogTitle }}</title>
<meta name="description" content="{{ ogDesc }}">
<meta name="robots" content="max-image-preview:large">
<meta property="og:title" content="{{ ogTitle }}">
<meta property="og:description" content="{{ ogDesc }}">
<meta property="og:type" content="{% if tags and 'posts' in tags %}article{% else %}website{% endif %}">
<meta property="og:url" content="{{ ogUrl }}">
<meta property="og:image" content="https://raihanlite.github.io/sock-guide/img/artifact/{{ heroFile }}">
<meta property="og:image:width" content="{{ heroSize.width }}">
<meta property="og:image:height" content="{{ heroSize.height }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ ogTitle }}">
<meta name="twitter:description" content="{{ ogDesc }}">
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"WebSite","name":"Sock Guide","url":"https://raihanlite.github.io/sock-guide/","description":{{ site.description | dump | safe }},"publisher":{"@type":"Organization","name":"Sock Guide"}}
</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800;900&family=IBM+Plex+Mono:wght@400;500&family=Public+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
<div class="shell">
<header class="site">
  <div class="header-in">
    <div class="head-left">
      <button class="burger" id="menuBtn" aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button>
      <nav class="head-cats" aria-label="Categories">
        <a href="{{ '/work/' | url }}">Work</a><a href="{{ '/sports/' | url }}">Sports</a><a href="{{ '/heated/' | url }}">Heated</a>
      </nav>
    </div>
    <a class="wordmark" href="{{ '/' | url }}">sock guide</a>
    <div class="head-right">
      <a class="rlink" href="{{ '/about/' | url }}">About</a><a class="rlink" href="{{ '/contact/' | url }}">Contact</a>
      <button class="icon-btn" id="searchBtn" aria-label="Search guides" aria-expanded="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg></button>
    </div>
  </div>
  <div class="accent-line" aria-hidden="true"></div>
  <div class="searchbar" id="searchBar">
    <form id="searchForm" role="search">
      <input type="search" id="searchInput" name="search" placeholder="Search guides — try “work boots”, “alpaca”, “tennis”…" aria-label="Search guides">
      <button class="btn-black" type="submit">Search</button>
    </form>
    <p class="search-note" id="searchNote" role="status"></p>
  </div>
</header>

<div class="overlay" id="overlay"></div>
<aside class="drawer" id="drawer" aria-label="Site menu">
  <div class="drawer-top">
    <a class="wordmark" href="{{ '/' | url }}">sock guide</a>
    <button class="drawer-close" id="drawerClose" aria-label="Close menu">&times;</button>
  </div>
  <h2>Categories</h2>
  <nav>
    <a href="{{ '/work/' | url }}">Work</a>
    <a href="{{ '/sports/' | url }}">Sports &amp; Outdoor</a>
    <a href="{{ '/heated/' | url }}">Heated</a>
    <a href="{{ '/guides/' | url }}">Buying Guides</a>
  </nav>
  <h2>Information</h2>
  <nav>
    <a href="{{ '/about/' | url }}">About</a>
    <a href="{{ '/privacy/' | url }}">Privacy Policy</a>
    <a href="{{ '/contact/' | url }}">Contact</a>
    <a href="{{ '/' | url }}">All Guides</a>
  </nav>
</aside>

<main class="page-pad">
<div class="view active"{% if isHome %} id="view-home"{% endif %}>
{{ content | safe }}
</div>
</main>

<footer class="site">
  <div class="page-pad">
  <div class="foot-top">
    <a class="wordmark" href="{{ '/' | url }}">sock guide</a>
    <nav class="socials" aria-label="Social media">
      <a href="#home" aria-label="Sock Guide on Facebook"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13 22v-8h3l.5-4H13V7.5c0-1 .3-1.5 1.6-1.5H17V2.2C16.4 2.1 15.2 2 13.9 2 11.1 2 9 3.7 9 7v3H6v4h3v8h4z"/></svg></a>
      <a href="#home" aria-label="Sock Guide on Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"/></svg></a>
      <a href="#home" aria-label="Sock Guide on X"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.9 2H22l-6.8 7.8L23.2 22h-6.3l-4.9-6.4L6.4 22H3.2l7.3-8.3L2.8 2h6.4l4.4 5.9L18.9 2zm-1.1 18h1.7L7.4 3.9H5.6L17.8 20z"/></svg></a>
      <a href="#home" aria-label="Sock Guide on YouTube"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10.5 9.3l5.2 2.7-5.2 2.7z" fill="currentColor" stroke="none"/></svg></a>
    </nav>
  </div>
  <div class="foot-grid">
    <nav aria-label="Categories">
      <ul>
        <li><a href="{{ '/work/' | url }}">Work</a></li>
        <li><a href="{{ '/sports/' | url }}">Sports &amp; Outdoor</a></li>
        <li><a href="{{ '/heated/' | url }}">Heated</a></li>
      </ul>
    </nav>
    <nav aria-label="Information">
      <ul>
        <li><a href="{{ '/about/' | url }}">About</a></li>
        <li><a href="{{ '/contact/' | url }}">Contact</a></li>
        <li><a href="{{ '/privacy/' | url }}">Privacy Policy</a></li>
      </ul>
    </nav>
    <div class="foot-news">
      <form class="news-form" data-newsletter>
        <input type="email" id="newsletter-email-footer" name="email" placeholder="Email" required aria-label="Email address">
        <button class="btn-black" type="submit">SUBSCRIBE NOW</button>
      </form>
      <p class="foot-accept">By clicking subscribe you accept our <a href="{{ '/privacy/' | url }}">Privacy Policy</a></p>
      <p class="news-done" role="status">Your email app is opening — send the message there to finish subscribing.</p>
    </div>
  </div>
  <div class="foot-bottom">
    <p>© 2026 Sock Guide.</p>
  </div>
  </div>
</footer>
</div>
<script>
(function () {
  var drawer = document.getElementById('drawer'), overlay = document.getElementById('overlay'),
      menuBtn = document.getElementById('menuBtn'), closeBtn = document.getElementById('drawerClose');
  function openDrawer(o) {
    drawer.classList.toggle('open', o); overlay.classList.toggle('open', o);
    document.body.classList.toggle('locked', o);
    menuBtn.setAttribute('aria-expanded', o);
  }
  menuBtn.addEventListener('click', function () { openDrawer(true); });
  closeBtn.addEventListener('click', function () { openDrawer(false); });
  overlay.addEventListener('click', function () { openDrawer(false); });
  drawer.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { openDrawer(false); }); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') openDrawer(false); });

  var searchBtn = document.getElementById('searchBtn'), searchBar = document.getElementById('searchBar'),
      searchForm = document.getElementById('searchForm'), searchInput = document.getElementById('searchInput');
  searchBtn.addEventListener('click', function () {
    var open = searchBar.classList.toggle('open');
    searchBtn.setAttribute('aria-expanded', open);
    if (open) searchInput.focus();
  });
  // Artifact search behaviour: live on input; the query is lower-cased and
  // matched as a substring against each post row / featured card's
  // data-search attribute plus its visible text. Non-matches get class
  // "filtered-out". While a query is active the post list gets class
  // "show-all" and Load More is hidden; clearing restores the default view.
  // Only post rows (not featured cards) are counted in the match count.
  function applySearch() {
    var raw = searchInput.value.trim();
    var q = raw.toLowerCase();
    var list = document.querySelector('.post-list');
    var loadMoreBtn = document.getElementById('loadMoreBtn');
    var note = document.getElementById('searchNote');
    var noResults = document.getElementById('noResults');
    var rows = document.querySelectorAll('.post-item');
    var cards = document.querySelectorAll('.feat-card');
    function haystack(el) {
      return ((el.getAttribute('data-search') || '') + ' ' + el.textContent).toLowerCase();
    }
    if (!q) {
      rows.forEach(function (el) { el.classList.remove('filtered-out'); });
      cards.forEach(function (el) { el.classList.remove('filtered-out'); });
      if (list) list.classList.remove('show-all');
      if (loadMoreBtn && document.querySelector('.post-item.extra')) loadMoreBtn.style.display = '';
      if (note) note.classList.remove('show');
      if (noResults) noResults.classList.remove('show');
      return;
    }
    if (list) list.classList.add('show-all');
    if (loadMoreBtn) loadMoreBtn.style.display = 'none';
    var matches = 0;
    rows.forEach(function (el) {
      var hit = haystack(el).indexOf(q) !== -1;
      el.classList.toggle('filtered-out', !hit);
      if (hit) matches++;
    });
    cards.forEach(function (el) {
      el.classList.toggle('filtered-out', haystack(el).indexOf(q) === -1);
    });
    // The match note / no-results line only live on the homepage list.
    if (note && list) {
      note.classList.add('show');
      note.textContent = matches === 0
        ? 'No guides match \u201c' + raw + '\u201d yet.'
        : matches === 1
          ? '1 guide matches \u201c' + raw + '\u201d.'
          : matches + ' guides match \u201c' + raw + '\u201d.';
    }
    if (noResults && list) noResults.classList.toggle('show', matches === 0);
  }
  searchInput.addEventListener('input', applySearch);
  // Submit (Enter) also scrolls to the post list, as in the artifact.
  searchForm.addEventListener('submit', function (e) {
    e.preventDefault();
    var latest = document.getElementById('latest');
    if (latest) latest.scrollIntoView();
  });

  // Newsletter (sidebar + footer): opens the reader's email app with a
  // pre-addressed subscription message, then shows the confirmation line.
  document.querySelectorAll('[data-newsletter]').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var email = form.querySelector('input[type="email"]').value.trim();
      var subject = encodeURIComponent('Sock Guide newsletter subscription');
      var body = encodeURIComponent('Please subscribe this email address to the Sock Guide newsletter: ' + email);
      window.location.href = 'mailto:hello@sockguide.com?subject=' + subject + '&body=' + body;
      var note = form.parentElement.querySelector('.news-done');
      if (note) note.classList.add('show');
      form.style.display = 'none';
    });
  });
})();
</script>
</body>
</html>
