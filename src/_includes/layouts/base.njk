<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if docTitle %}{{ docTitle }}{% else %}{{ title }} | {{ site.title }}{% endif %}</title>
<meta name="description" content="{{ description or site.description }}">
<meta property="og:title" content="{% if docTitle %}{{ docTitle }}{% else %}{{ title }} | {{ site.title }}{% endif %}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:type" content="article">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;800;900&family=IBM+Plex+Mono:wght@400;500&family=Public+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
<header class="site-header"><div class="wrap">
  <div class="bar">
    <div style="display:flex;align-items:center;gap:16px;">
      <button class="menu-btn" id="menuBtn" aria-label="Open menu" aria-expanded="false"><span></span><span></span><span></span></button>
      <nav class="top-cats" aria-label="Categories">
        <a href="{{ '/work/' | url }}">Work</a><a href="{{ '/sports/' | url }}">Sports</a><a href="{{ '/heated/' | url }}">Heated</a>
      </nav>
    </div>
    <a class="wordmark" href="{{ '/' | url }}">sock guide</a>
    <div class="top-links">
      <a href="{{ '/about/' | url }}">About</a><a href="{{ '/contact/' | url }}">Contact</a>
      <button class="search-btn" id="searchBtn" aria-label="Search guides" aria-expanded="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg></button>
    </div>
  </div>
  <div class="search-row" id="searchRow"><label class="sr-only" for="searchInput">Search guides</label><input type="search" id="searchInput" name="search" placeholder="Search guides — try “work boots”, “alpaca”, “tennis”…"></div>
  <div class="accent-line" aria-hidden="true"></div>
</div></header>

<nav class="drawer" id="drawer" aria-label="Site menu">
  <button class="close-btn" id="drawerClose" aria-label="Close menu">&times;</button>
  <h2>Categories</h2>
  <a href="{{ '/work/' | url }}">Work</a>
  <a href="{{ '/sports/' | url }}">Sports &amp; Outdoor</a>
  <a href="{{ '/heated/' | url }}">Heated</a>
  <a href="{{ '/guides/' | url }}">Buying Guides</a>
  <h2>Information</h2>
  <a href="{{ '/about/' | url }}">About</a>
  <a href="{{ '/privacy/' | url }}">Privacy Policy</a>
  <a href="{{ '/contact/' | url }}">Contact</a>
  <a href="{{ '/' | url }}">All Guides</a>
</nav>
<div class="overlay" id="overlay"></div>

<main class="wrap">{{ content | safe }}</main>

<footer class="site-footer"><div class="wrap">
  <div class="footer-top">
    <a class="wordmark" href="{{ '/' | url }}">sock guide</a>
    <div class="social-icons" aria-label="Social links">
      <span title="Facebook" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 21v-7h2.4l.4-3h-2.8V9.1c0-.9.3-1.5 1.6-1.5h1.3V4.9c-.3 0-1.1-.1-2.1-.1-2.1 0-3.6 1.3-3.6 3.7V11H8.3v3h2.4v7h2.8z"/></svg></span>
      <span title="Instagram" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="0"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/></svg></span>
      <span title="X" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.7 3H21l-7.3 8.3L22.2 21h-6.7l-5.2-6.3L4.3 21H1l7.8-8.9L1.8 3h6.9l4.7 5.7L17.7 3zm-1.2 16h1.9L7 4.9H5L16.5 19z"/></svg></span>
      <span title="YouTube" aria-label="YouTube"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 8.2c-.2-1.4-1.4-2.4-2.8-2.6C17.4 5.3 15.2 5.2 12 5.2s-5.4.1-7.2.4C3.4 5.8 2.2 6.8 2 8.2 1.7 10 1.7 12 1.7 12s0 2 .3 3.8c.2 1.4 1.4 2.4 2.8 2.6 1.8.3 4 .4 7.2.4s5.4-.1 7.2-.4c1.4-.2 2.6-1.2 2.8-2.6.3-1.8.3-3.8.3-3.8s0-2-.3-3.8zM9.8 15.1V8.9L15.5 12l-5.7 3.1z"/></svg></span>
    </div>
  </div>
  <div class="footer-cols">
    <div>
      <a href="{{ '/work/' | url }}">Work</a><a href="{{ '/sports/' | url }}">Sports &amp; Outdoor</a><a href="{{ '/heated/' | url }}">Heated</a>
    </div>
    <div>
      <a href="{{ '/about/' | url }}">About</a><a href="{{ '/contact/' | url }}">Contact</a><a href="{{ '/privacy/' | url }}">Privacy Policy</a>
    </div>
    <div>
      <form class="newsletter-form footer-form" data-newsletter>
        <label class="sr-only" for="footerEmail">Email</label>
        <input type="email" id="footerEmail" name="email" placeholder="Email" required>
        <button class="btn" type="submit">SUBSCRIBE NOW</button>
      </form>
      <p class="footer-accept">By clicking subscribe you accept our <a href="{{ '/privacy/' | url }}">Privacy Policy</a></p>
      <p class="form-note" hidden>Your email app is opening — send the message there to finish subscribing.</p>
    </div>
  </div>
  <div class="footer-bottom">
    <p>© 2026 Sock Guide.</p>
  </div>
</div></footer>
<script>
(function () {
  var drawer = document.getElementById('drawer'), overlay = document.getElementById('overlay'),
      menuBtn = document.getElementById('menuBtn'), closeBtn = document.getElementById('drawerClose');
  function openDrawer(o) { drawer.classList.toggle('open', o); overlay.classList.toggle('open', o); menuBtn.setAttribute('aria-expanded', o); }
  menuBtn.addEventListener('click', function () { openDrawer(true); });
  closeBtn.addEventListener('click', function () { openDrawer(false); });
  overlay.addEventListener('click', function () { openDrawer(false); });
  drawer.querySelectorAll('a').forEach(function (a) { a.addEventListener('click', function () { openDrawer(false); }); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') openDrawer(false); });

  var searchBtn = document.getElementById('searchBtn'), searchRow = document.getElementById('searchRow'),
      searchInput = document.getElementById('searchInput');
  searchBtn.addEventListener('click', function () {
    var open = searchRow.classList.toggle('open');
    searchBtn.setAttribute('aria-expanded', open);
    if (open) searchInput.focus();
  });
  // Artifact search behaviour: live on input; the query is lower-cased and
  // matched as a substring against each post row / featured card's
  // data-search attribute plus its visible text. Non-matches get class
  // "filtered-out". While a query is active the post list gets class
  // "show-all" and Load More is hidden; clearing restores the default view.
  // Only post rows (not featured cards) are counted in the match count.
  function applySearch() {
    var raw = searchInput.value.trim();
    var q = raw.toLowerCase();
    var list = document.querySelector('.latest-list');
    var loadMoreBtn = document.getElementById('loadMoreBtn');
    var note = document.getElementById('searchNote');
    var noResults = document.getElementById('noResults');
    var rows = document.querySelectorAll('.post-row');
    var cards = document.querySelectorAll('.feature-card');
    function haystack(el) {
      return ((el.getAttribute('data-search') || '') + ' ' + el.textContent).toLowerCase();
    }
    if (!q) {
      rows.forEach(function (el) { el.classList.remove('filtered-out'); });
      cards.forEach(function (el) { el.classList.remove('filtered-out'); });
      if (list) list.classList.remove('show-all');
      if (loadMoreBtn && document.querySelector('.post-row.extra')) loadMoreBtn.style.display = '';
      if (note) note.hidden = true;
      if (noResults) noResults.hidden = true;
      return;
    }
    if (list) list.classList.add('show-all');
    if (loadMoreBtn) loadMoreBtn.style.display = 'none';
    var matches = 0;
    rows.forEach(function (el) {
      var hit = haystack(el).indexOf(q) !== -1;
      el.classList.toggle('filtered-out', !hit);
      if (hit) matches++;
    });
    cards.forEach(function (el) {
      el.classList.toggle('filtered-out', haystack(el).indexOf(q) === -1);
    });
    if (note) {
      note.hidden = false;
      note.textContent = matches === 0
        ? 'No guides match \u201c' + raw + '\u201d yet.'
        : matches === 1
          ? '1 guide matches \u201c' + raw + '\u201d.'
          : matches + ' guides match \u201c' + raw + '\u201d.';
    }
    if (noResults) noResults.hidden = matches !== 0;
  }
  searchInput.addEventListener('input', applySearch);
  // Submit (Enter) also scrolls to the post list, as in the artifact.
  searchInput.addEventListener('keydown', function (e) {
    if (e.key === 'Enter') {
      e.preventDefault();
      var latest = document.getElementById('latest');
      if (latest) latest.scrollIntoView();
    }
  });

  // Newsletter (sidebar + footer): opens the reader's email app with a
  // pre-addressed subscription message, then shows the confirmation line.
  document.querySelectorAll('[data-newsletter]').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var email = form.querySelector('input[type="email"]').value.trim();
      var subject = encodeURIComponent('Sock Guide newsletter subscription');
      var body = encodeURIComponent('Please subscribe this email address to the Sock Guide newsletter: ' + email);
      window.location.href = 'mailto:hello@sockguide.com?subject=' + subject + '&body=' + body;
      var note = form.parentElement.querySelector('.form-note');
      if (note) note.hidden = false;
      form.style.display = 'none';
    });
  });
})();
</script>
</body>
</html>
