---
layout: layouts/base.njk
---
<div class="cat-head"><h1>{{ title }}</h1></div>
<div class="feat-grid2">
{# Category membership is an explicit slug list (artifact order) so pages
   can group posts across frontmatter categories — e.g. Sports lists the
   alpaca, heated and tennis guides, as in the artifact. Falls back to the
   frontmatter `category` filter when no `slugs` list is given. Titles,
   labels, images and search keywords come from the artifact overrides. #}
{% set catPosts = [] %}
{% if slugs %}
{% for slug in slugs %}
{% for p in collections.posts %}{% if p.fileSlug == slug %}{% set catPosts = catPosts.concat([p]) %}{% endif %}{% endfor %}
{% endfor %}
{% else %}
{% for p in collections.posts %}{% if p.data.category == category %}{% set catPosts = catPosts.concat([p]) %}{% endif %}{% endfor %}
{% endif %}
{% for p in catPosts %}
{% set a = artifact.posts[p.fileSlug] %}
  <a class="feat-card" href="{{ p.url }}"{% if a.dataSearch %} data-search="{{ a.dataSearch }}"{% endif %}>
    <div class="ph"><img src="{{ ('/' ~ (a.image or ('img/' ~ p.data.image))) | url }}" alt="{{ a.imageAlt or p.data.imageAlt }}"></div>
    <div class="label-box">
      <p class="kicker">{{ a.label or p.data.category }}</p>
      <h3>{{ a.cardTitle or p.data.title }}</h3>
    </div>
  </a>
{% endfor %}
</div>
