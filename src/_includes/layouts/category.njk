---
layout: layouts/base.njk
---
<header class="cat-head"><h1>{{ title }}</h1></header>
<section class="feat-grid2" aria-label="{{ title }}">
{# Category membership is an explicit slug list (artifact order) so pages
   can group posts across frontmatter categories — e.g. Sports lists the
   alpaca, heated and tennis guides, as in the artifact. Falls back to the
   frontmatter `category` filter when no `slugs` list is given. Titles,
   labels, images and search keywords come from the artifact overrides. #}
{% set catPosts = [] %}
{% if slugs %}
{% for slug in slugs %}
{% for p in collections.posts %}{% if p.fileSlug == slug %}{% set catPosts = catPosts.concat([p]) %}{% endif %}{% endfor %}
{% endfor %}
{% else %}
{% for p in collections.posts %}{% if p.data.category == category %}{% set catPosts = catPosts.concat([p]) %}{% endif %}{% endfor %}
{% endif %}
{% for p in catPosts %}
{% set a = artifact.posts[p.fileSlug] %}
  <a class="feat-card{% if loop.index > 10 %} extra{% endif %}" href="{{ p.url }}"{% if a.dataSearch %} data-search="{{ a.dataSearch }}"{% endif %}>
    <div class="ph"><img src="{{ ('/' ~ (a.image or ('img/' ~ p.data.image))) | url }}" alt="{{ a.imageAlt or p.data.imageAlt }}" loading="lazy"></div>
    <div class="label-box">
      <p class="kicker">{{ a.label or p.data.category }}</p>
      <h3>{{ a.cardTitle or p.data.title }}</h3>
    </div>
  </a>
{% endfor %}
</section>
<div class="load-more-wrap"><button class="btn-load" id="loadMoreBtn" type="button">LOAD MORE</button></div>

<script>
(function () {
  var btn = document.getElementById('loadMoreBtn');
  var grid = document.querySelector('.feat-grid2');
  if (!btn || !grid) return;
  // Load More in batches of 10: each click reveals the next 10 hidden
  // cards; the button hides when nothing is left hidden. Cards after the
  // first 10 carry class "extra" (hidden by CSS) until they get "revealed".
  // Search still uses the grid's "show-all" class to show every match,
  // and removing it restores this batched view.
  function hiddenCards() {
    return grid.querySelectorAll('.feat-card.extra:not(.revealed)');
  }
  btn.addEventListener('click', function () {
    var cards = hiddenCards();
    for (var i = 0; i < 10 && i < cards.length; i++) {
      cards[i].classList.add('revealed');
    }
    if (hiddenCards().length === 0) btn.style.display = 'none';
  });
  if (hiddenCards().length === 0) btn.style.display = 'none';
})();
</script>
